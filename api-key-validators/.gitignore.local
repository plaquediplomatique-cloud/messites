# API Key Validators - Local Override
# This is a reference for what should be in the root .gitignore

# Never commit actual API keys
*/list.txt

# Never commit validation results (may contain sensitive info)
*/results.txt

# Environment files
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
*.egg-info/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
